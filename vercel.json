{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { 
          "key": "Cache-Control", 
          "value": "no-cache, no-store, must-revalidate" 
        },
        { 
          "key": "Content-Type", 
          "value": "application/manifest+json" 
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/whatsapp-send",
      "destination": "/api/whatsapp-send.ts"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/manifest"
    },
    {
      "source": "/api-proxy/sunat-vps/:path*",
      "destination": "https://:path*"
    },
    {
      "source": "/api-proxy/decolecta/:path*",
      "destination": "https://api.decolecta.com/v1/:path*"
    },
    {
      "source": "/owner-login",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}